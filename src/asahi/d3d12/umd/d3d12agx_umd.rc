#ifndef AURORA_WDDM_MAJOR
#define AURORA_WDDM_MAJOR 21
#endif

#define AURORA_STRINGIFY_INNER(value) #value
#define AURORA_STRINGIFY(value) AURORA_STRINGIFY_INNER(value)
#define AURORA_DRIVER_VERSION_STRING \
   AURORA_STRINGIFY(AURORA_WDDM_MAJOR) ".17.240.0"

1 VERSIONINFO
 FILEVERSION AURORA_WDDM_MAJOR,17,240,0
 PRODUCTVERSION AURORA_WDDM_MAJOR,17,240,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x00040004L
 FILETYPE 0x00000003L
 FILESUBTYPE 0x00000004L
BEGIN
   BLOCK "StringFileInfo"
   BEGIN
      BLOCK "040904b0"
      BEGIN
         VALUE "CompanyName", "Aurora Silicon"
         VALUE "FileDescription", "Aurora Silicon native Apple AGX D3D12 WDDM UMD"
         VALUE "FileVersion", AURORA_DRIVER_VERSION_STRING
         VALUE "InternalName", "d3d12agx_umd"
         VALUE "OriginalFilename", "d3d12agx_umd.dll"
         VALUE "ProductName", "Aurora Silicon Apple AGX graphics driver"
         VALUE "ProductVersion", AURORA_DRIVER_VERSION_STRING
      END
   END
   BLOCK "VarFileInfo"
   BEGIN
      VALUE "Translation", 0x0409, 1200
   END
END
