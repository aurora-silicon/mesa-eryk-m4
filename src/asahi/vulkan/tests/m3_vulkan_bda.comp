#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Output { uint value; };
layout(constant_id = 0) const uint address_low = 0;
layout(constant_id = 1) const uint address_high = 0;
void main() { Output(uvec2(address_low, address_high)).value = 0x12340000u; }
