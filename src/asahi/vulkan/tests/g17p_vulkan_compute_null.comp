#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Output {
   uint values[];
} output_buffer;

/* Deliberately performs NO memory access at run time.
 *
 * Every probe so far has loaded or stored, so nothing we have measured
 * separates "dispatches execute and the memory access faults" from "no
 * dispatch has ever executed". The guard is never true for a 32-thread grid
 * but is not compile-time foldable, so the shader keeps its store (and so is
 * not eliminated as empty, which would make Honeykrisp skip the dispatch
 * entirely) while executing no load or store.
 *
 * The observable is the RETIRE DURATION in dmesg, not this buffer.
 */
void
main()
{
   if (gl_GlobalInvocationID.x > 1000000u) {
      output_buffer.values[gl_GlobalInvocationID.x] = 0x12340000u;
   }
}
