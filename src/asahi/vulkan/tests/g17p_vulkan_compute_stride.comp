#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Output {
   uint values[];
} output_buffer;

/* Regression test for the register-index SHIFT scaling.
 *
 * Originally built to separate "only 8 lanes run" from "32 lanes run, stores
 * past byte 32 discarded". That question is settled and neither answer was
 * right: all 32 lanes were always running, and the 8 touched elements came
 * from the store's register index being scaled by shift 0 instead of
 * log2(element bytes). Lane l addressed base + l BYTES, the hardware aligned
 * the 32-bit access down, and lanes 4i..4i+3 all collapsed onto element i --
 * 8 touched elements, each holding the lowest lane of its group (K+4i).
 *
 * The probe is kept because it exercises a NON-TRIVIAL shift, which the
 * simpler probes do not: an element stride of 2 needs
 * shift == log2(4) + log2(2) == 3, so it covers the scaling arithmetic rather
 * than just the base case.
 *
 *   32 elements at even indices 0,2,...,62, values 0x55550000 + l
 *      -> shift scaling correct for a strided index
 *   8 or 16 elements, or values landing at the wrong stride
 *      -> the shift is still being computed with the AGX2 convention
 *         (agx_nir_lower_address() subtracts format_shift; AGX3 hardware does
 *         not re-apply it)
 */
void
main()
{
   uint l = gl_LocalInvocationID.x;
   output_buffer.values[l * 2u] = 0x55550000u + l;
}
