#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Output {
   uint values[];
} output_buffer;

/* Deliberately minimal: one store of a computed constant, no constant-data
 * array, so the shader needs no rodata range and no second uniform load. This
 * isolates "does any G17P Vulkan dispatch execute" from "does our compiler's
 * constant-data path work". */
void
main()
{
   output_buffer.values[gl_GlobalInvocationID.x] =
      0x12340000u + gl_GlobalInvocationID.x;
}
