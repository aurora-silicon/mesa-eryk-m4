#version 450
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_int8: require
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) buffer Data {
 u8vec4 source;
 uint loaded[4];
 u8vec4 stored;
 uint barrierword;
} data;
void main() {
 u8vec4 v=data.source;
 data.loaded[0]=uint(v.x); data.loaded[1]=uint(v.y);
 data.loaded[2]=uint(v.z); data.loaded[3]=uint(v.w);
 data.stored=u8vec4(uint8_t(0x12),uint8_t(0x34),uint8_t(0x56),uint8_t(0x78));
}
