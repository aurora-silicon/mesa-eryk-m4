+VkResult VulkanReplayConsumerBase::OverrideGetSemaphoreCounterValue(
+    PFN_vkGetSemaphoreCounterValue func,
+    VkResult original_result,
+    const VulkanDeviceInfo* device_info,
+    const VulkanSemaphoreInfo* semaphore_info,
+    PointerDecoder<uint64_t>* pValue)
+{
+    assert(device_info != nullptr && semaphore_info != nullptr && pValue != nullptr);
+    const uint64_t captured_value = pValue->IsNull() ? 0 : *pValue->GetPointer();
+    uint64_t* value = pValue->IsNull() ? nullptr : pValue->AllocateOutputData(1, uint64_t{0});
+    const VkDevice device = device_info->handle;
+    const VkSemaphore semaphore = semaphore_info->handle;
+    VkResult result = func(device, semaphore, value);
+    if (original_result == VK_SUCCESS && result == VK_SUCCESS && value && *value < captured_value)
+    {
+        // Recorded host control flow may free resources after observing this
+        // timeline value. Reproduce that progress before the next recorded
+        // call, just as OverrideGetFenceStatus waits for a captured success.
+        const VkSemaphoreWaitInfo wait_info = {
+            VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO, nullptr, 0, 1, &semaphore, &captured_value};
+        auto device_table = GetInjectedDeviceCalls(device);
+        auto injected = device_table.Open();
+        if (GetDeviceTable(device)->WaitSemaphores)
+            result = injected->WaitSemaphores(device, &wait_info, std::numeric_limits<uint64_t>::max());
+        else
+            result = injected->WaitSemaphoresKHR(device, &wait_info, std::numeric_limits<uint64_t>::max());
+        if (result != VK_SUCCESS)
+            return result;
+        result = func(device, semaphore, value);
+    }
+    return result;
+}
