#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Data {uint64_t data[];} src;
shared uint64_t local_data[64];
void main(){uint i=gl_GlobalInvocationID.x;local_data[i]=src.data[i];barrier();src.data[128u+i]=atomicOr(local_data[i],src.data[64u+i]);barrier();src.data[i]=local_data[i];}
