 // CompressedTextureForBlit is a helper class that stores compressed texture data.
 // Implementation is based on pipeline::TestTexture2D but it allocates only one level
 // and has special cases needed for blits to some formats.
+
+// Quantize scaled references before the nearest-texel lookup. Packed scaled
+// setPixel paths truncate floats, unlike ordinary scaled channels; explicitly
+// clamp and round here without changing the test's source image generation.
+static tcu::Vec4 scaledBlitReference(const tcu::Vec4 &value, const tcu::TextureFormat &format)
+{
+    const auto info = tcu::getTextureFormatInfo(format);
+    return tcu::roundToEven(tcu::clamp(value, info.valueMin, info.valueMax));
+}
 
