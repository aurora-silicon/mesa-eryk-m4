+// Vulkan owns separate Wayland queues and may block in acquire/present for
+// many frames without returning to the platform event loop. Keep dispatching
+// the application's queue so configure acknowledgements and pongs are sent.
+class EventPump : public de::Thread
+{
+public:
+	explicit EventPump(struct wl_display* display) : m_display(display), m_stop(0) {}
+	~EventPump(void)
+	{
+		if (isStarted())
+		{
+			deAtomicCompareExchange32(&m_stop, 0, 1);
+			join();
+		}
+	}
+	void run(void)
+	{
+		while (!deAtomicCompareExchange32(&m_stop, 0, 0))
+		{
+			while (wl_display_prepare_read(m_display) != 0)
+				if (wl_display_dispatch_pending(m_display) < 0 ||
+					deAtomicCompareExchange32(&m_stop, 0, 0))
+					return;
+			const int flushed = wl_display_flush(m_display);
+			if (flushed < 0 && errno != EAGAIN)
+			{
+				wl_display_cancel_read(m_display);
+				return;
+			}
+			struct pollfd fd = { wl_display_get_fd(m_display),
+				(short)(POLLIN | (flushed < 0 ? POLLOUT : 0)), 0 };
+			const int ready = poll(&fd, 1, 100);
+			if (ready > 0 && (fd.revents & POLLIN))
+			{
+				if (wl_display_read_events(m_display) < 0)
+					return;
+			}
+			else
