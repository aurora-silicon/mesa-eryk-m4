+
+TEST(DamageRing, sparseSelectionEdgesDoNotBecomeFullScreenDamage) {
+    CDamageRing ring;
+    ring.setSize({2560, 1664});
+    ring.rotate();
+
+    CRegion expected;
+    for (int frame = 0; frame < DAMAGE_RING_PREVIOUS_LEN; ++frame) {
+        // Narrow changing edges plus separated cursor damage across buffers.
+        CRegion change{2200.0 + frame * 8, 60, 4, 1300};
+        change.add(CBox{60, 1400.0 + frame * 8, 2100, 4});
+        change.add(CBox{100.0 + frame * 100, 100, 8, 8});
+        expected.add(change);
+        ring.damage(change);
+        ring.rotate();
+    }
+    const auto damage = ring.getBufferDamage(DAMAGE_RING_PREVIOUS_LEN + 1);
+    EXPECT_TRUE(damage.copy().subtract(expected).empty());
+    EXPECT_TRUE(expected.copy().subtract(damage).empty());
+}
