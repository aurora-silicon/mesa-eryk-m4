+bool CLayerSurface::contentFullyOccluded() const {
+    const auto MONITOR = m_monitor.lock();
+    if (!MONITOR || m_ruleApplicator->aboveLock().valueOrDefault())
+        return false;
+
+    // Restrict this fast path to content contained on this output and to a
+    // complete, untransformed logical output cover. Partial/animated coverage
+    // and same-layer ordering keep the ordinary damage path.
+    CRegion outside{m_geometry};
+    outside.subtract(MONITOR->logicalBox());
+    if (!outside.empty())
+        return false;
+
+    for (size_t layer = m_layer + 1; layer < MONITOR->m_layerSurfaceLayers.size(); ++layer) {
+        for (const auto& cover : MONITOR->m_layerSurfaceLayers[layer]) {
+            if (!cover || !cover->visible() || cover->m_noProcess || cover->m_ruleApplicator->aboveLock().valueOrDefault() || cover->m_ruleApplicator->blur().valueOrDefault() ||
+                cover->m_realPosition->isBeingAnimated() || cover->m_realSize->isBeingAnimated() || cover->alpha()[LS_ALPHA_FADE]->isBeingAnimated() ||
+                cover->alpha()[LS_ALPHA_FADE]->value() != 1.F)
+                continue;
+
+            const auto SURFACE  = cover->wlSurface();
+            const auto RESOURCE = SURFACE->resource();
+            if (!RESOURCE || !RESOURCE->m_current.texture || SURFACE->m_alphaModifier != 1.F || SURFACE->m_overallOpacity != 1.F || !SURFACE->m_visibleRegion.empty() ||
+                cover->position(GEOMETRIC_CURRENT) != MONITOR->m_position || cover->size(GEOMETRIC_CURRENT) != MONITOR->m_size || RESOURCE->m_current.size != MONITOR->m_size)
+                continue;
+
+            CRegion uncovered{CBox{{}, MONITOR->m_size}};
+            uncovered.subtract(RESOURCE->m_current.opaque);
+            if (uncovered.empty())
+                return true;
+        }
+    }
+
+    return false;
+}
