+    // Coalesce dense damage, but retain sparse borders and cursor trails.
+    // Nine narrow strips must not expand into a nearly full-screen repaint.
+    // Keep a hard complexity bound for pathological client damage.
+    const auto RECTS = pixman_region32_n_rects(damage.pixman());
+    if (RECTS > 8) {
+        uint64_t area = 0;
+        damage.forEachRect([&area](const auto& r) { area += uint64_t(r.x2 - r.x1) * uint64_t(r.y2 - r.y1); });
+        const auto EXTENTS = damage.getExtents();
+        if (RECTS > 64 || double(area) * 2 >= EXTENTS.w * EXTENTS.h)
+            return EXTENTS;
+    }
 
     return damage;
 }
