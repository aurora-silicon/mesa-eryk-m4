diff --git a/src/asahi/vulkan/hk_queue.c b/src/asahi/vulkan/hk_queue.c
index 196d2cb08fa..af76e6a4de3 100644
--- a/src/asahi/vulkan/hk_queue.c
+++ b/src/asahi/vulkan/hk_queue.c
@@ -1183,7 +1183,10 @@ queue_submit(struct hk_device *dev, struct hk_queue *queue,
       struct hk_cmd_buffer *cmdbuf =
          (struct hk_cmd_buffer *)submit->command_buffers[i];
 
-      command_count += list_length(&cmdbuf->control_streams);
+      list_for_each_entry(struct hk_cs, cs, &cmdbuf->control_streams, node) {
+         if (!getenv("HK_M4_PRE_RENDER_DUMP") || cs->type == HK_CS_CDM)
+            command_count++;
+      }
    }
 
    perf_debug_dev(&dev->dev,
@@ -1248,6 +1251,8 @@ queue_submit(struct hk_device *dev, struct hk_queue *queue,
          (struct hk_cmd_buffer *)submit->command_buffers[i];
 
       list_for_each_entry(struct hk_cs, cs, &cmdbuf->control_streams, node) {
+         if (getenv("HK_M4_PRE_RENDER_DUMP") && cs->type == HK_CS_VDM)
+            continue;
          /* Barrier on previous command */
          struct drm_asahi_cmd_header header =
             agx_cmd_header(cs->type == HK_CS_CDM, nr_vdm, nr_cdm);
@@ -1329,7 +1334,8 @@ hk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
    if (result != VK_SUCCESS)
       result = vk_queue_set_lost(&queue->vk, "Submit failed");
 
-   if ((dev->dev.debug & AGX_DBG_SYNC) || getenv("HK_M4_TESS_DUMP")) {
+   if ((dev->dev.debug & AGX_DBG_SYNC) || getenv("HK_M4_TESS_DUMP") ||
+       getenv("HK_M4_PRE_RENDER_DUMP") || getenv("HK_M4_APP_WORDS")) {
       /* Debug memory inspection requires completed GPU writes. */
       int err = drmSyncobjTimelineWait(
          dev->dev.fd, &queue->drm.syncobj, &queue->drm.timeline_value, 1,
@@ -1341,8 +1347,43 @@ hk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
          VkResult res = dev->vk.check_status(&dev->vk);
          if (result == VK_SUCCESS)
             result = res;
+         if (result == VK_SUCCESS && getenv("HK_M4_APP_WORDS")) {
+            unsigned seen = 0;
+            simple_mtx_lock(&dev->dev.bo_map_lock);
+            for (uint32_t h = 0; h < dev->dev.max_handle && seen < 16; ++h) {
+               struct agx_bo *bo = agx_lookup_bo(&dev->dev, h);
+               if (!bo->size || !bo->va || strcmp(bo->label, "App memory"))
+                  continue;
+               ++seen;
+               const uint32_t *map = agx_bo_map(bo);
+               if (!map) continue;
+               unsigned n = MIN2(bo->size / 4, 1024 * 1024), printed = 0;
+               fprintf(stderr, "APP_WORDS va=%llx size=%llu", (unsigned long long)bo->va->addr, (unsigned long long)bo->size);
+               for (unsigned w = 0; w < n && printed < 64; ++w) {
+                  if (map[w]) { fprintf(stderr, " %u:%08x",w,map[w]); ++printed; }
+               }
+               fputc('\n', stderr);
+            }
+            simple_mtx_unlock(&dev->dev.bo_map_lock);
+         }
          if (result == VK_SUCCESS && getenv("HK_M4_TESS_DUMP"))
             hk_tess_debug_submit(dev, submit);
+         if (result == VK_SUCCESS && getenv("HK_M4_PRE_RENDER_DUMP")) {
+            bool dumped = false;
+            for (unsigned i = 0; i < submit->command_buffer_count; ++i) {
+               struct hk_cmd_buffer *cmd = (void *)submit->command_buffers[i];
+               list_for_each_entry(struct hk_cs, cs, &cmd->control_streams, node) {
+                  if (cs->type == HK_CS_VDM && !cs->stream_linked) {
+                     hk_g17p_trace_hexdump("vdm-stream", cs->addr, cs->start,
+                                           cs->current - cs->start);
+                     dumped = true;
+                  }
+               }
+            }
+            if (dumped)
+               result = vk_device_set_lost(&dev->vk,
+                  "Diagnostic: pre-render compute completed, VDM dumped without execution");
+         }
       }
    }
 
