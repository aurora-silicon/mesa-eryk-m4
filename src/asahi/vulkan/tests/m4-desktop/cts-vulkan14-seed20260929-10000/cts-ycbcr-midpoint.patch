+// Scaled source values are not normalized. The ordinary threshold helper
+// expresses integer-format conversion error in units of the normalized range;
+// convert that error back to the source value domain before comparing floats.
+static tcu::Vec4 scaledSourceThreshold(const tcu::TextureFormat &format)
+{
+    const auto info = tcu::getTextureFormatInfo(format);
+    return getFormatThreshold(format) * tcu::max(info.valueMax - info.valueMin, tcu::Vec4(1.0f));
+}
+
+// RGB9E5's quantization step depends on the shared exponent, not on a fixed
+// absolute tolerance. A conversion may round to either adjacent value. Retain
+// the ordinary comparison for other formats, and log normalized error only
+// when this per-pixel comparison fails.
+static bool compareScaledLinearResult(tcu::TestLog &log,
+                                      const tcu::ConstPixelBufferAccess &reference,
+                                      const tcu::ConstPixelBufferAccess &result,
+                                      const tcu::Vec4 &threshold)
+{
+    const bool packedFloat = result.getFormat().type == tcu::TextureFormat::UNSIGNED_INT_11F_11F_10F_REV;
+    if (result.getFormat().type != tcu::TextureFormat::UNSIGNED_INT_999_E5_REV && !packedFloat)
+        return tcu::floatThresholdCompare(log, "Compare", "Result comparison", reference,
+                                          result, threshold, tcu::COMPARE_LOG_ON_ERROR);
+    tcu::TextureLevel errors(tcu::TextureFormat(tcu::TextureFormat::RGBA, tcu::TextureFormat::FLOAT),
+                             result.getWidth(), result.getHeight(), result.getDepth());
+    tcu::TextureLevel zero(errors.getFormat(), result.getWidth(), result.getHeight(), result.getDepth());
+    tcu::clear(zero.getAccess(), tcu::Vec4(0.0f));
+    for (int z = 0; z < result.getDepth(); ++z)
+        for (int y = 0; y < result.getHeight(); ++y)
+            for (int x = 0; x < result.getWidth(); ++x)
+            {
+                const auto ref = reference.getPixel(x, y, z);
+                const auto got = result.getPixel(x, y, z);
+                // Decode the shared exponent from the retained reference,
+                // whose format is also RGB9E5. The exponent bias is 15 and
+                // the three stored mantissas have nine bits.
+                const auto ptr = static_cast<const uint8_t *>(reference.getDataPtr()) +
+                    z * reference.getSlicePitch() + y * reference.getRowPitch() + x * 4;
+                uint32_t packed;
+                deMemcpy(&packed, ptr, sizeof(packed));
+                const float quantum = deFloatLdExp(1.0f, int(packed >> 27) - 24);
+                tcu::Vec4 quantum4(quantum,quantum,quantum,0.0f);
+                if (packedFloat) {
+                    for (int c=0;c<3;++c) {
+                        const unsigned shift=c==0?6:c==1?17:27;
+                        const int exponent=int((packed>>shift)&31);
+                        quantum4[c]=deFloatLdExp(1.0f,de::max(exponent,1)-15-(c==2?5:6));
+                    }
+                }
+                const auto tolerance = threshold + quantum4;
+                errors.getAccess().setPixel(tcu::abs(got - ref) / tolerance, x, y, z);
+            }
+    return tcu::floatThresholdCompare(log, "Compare", "Error relative to format precision",
+                                      zero.getAccess(), errors.getAccess(), tcu::Vec4(1.0f),
+                                      tcu::COMPARE_LOG_ON_ERROR);
+}
+
+// Keep interpolation/decompression uncertainty before the scaled conversion.
+// Rounding a reference first loses which side of an integer boundary is valid.
+static bool compareScaledDestination(tcu::TestLog &log,
+    const tcu::ConstPixelBufferAccess &reference,
+    const tcu::ConstPixelBufferAccess &result, const tcu::Vec4 &threshold)
+{
+    tcu::TextureLevel errors(tcu::TextureFormat(tcu::TextureFormat::RGBA, tcu::TextureFormat::FLOAT),
+                            result.getWidth(), result.getHeight(), result.getDepth());
+    tcu::TextureLevel zero(errors.getFormat(), result.getWidth(), result.getHeight(), result.getDepth());
+    tcu::clear(zero.getAccess(), tcu::Vec4(0));
+    const auto bits = tcu::getTextureFormatBitDepth(result.getFormat());
+    for (int z=0; z<result.getDepth(); ++z)
+        for (int y=0; y<result.getHeight(); ++y)
+            for (int x=0; x<result.getWidth(); ++x) {
+                const auto ref=reference.getPixel(x,y,z), got=result.getPixel(x,y,z);
+                const auto lo=scaledBlitReference(ref-threshold,result.getFormat());
+                const auto hi=scaledBlitReference(ref+threshold,result.getFormat());
+                tcu::Vec4 error(0);
+                for (int c=0;c<4;++c)
+                    if (bits[c] && !(got[c]>=lo[c] && got[c]<=hi[c])) error[c]=1;
+                errors.getAccess().setPixel(error,x,y,z);
+            }
+    return tcu::floatThresholdCompare(log,"Compare","Scaled conversion interval violations",
+        zero.getAccess(),errors.getAccess(),tcu::Vec4(0),tcu::COMPARE_LOG_ON_ERROR);
+}
