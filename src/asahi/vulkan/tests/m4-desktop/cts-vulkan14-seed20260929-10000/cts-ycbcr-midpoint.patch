+// The test stores scaled reference values as integers. Vulkan's clear union
+// uses float32 for USCALED and SSCALED; keep reference generation unchanged.
+static VkClearColorValue apiClearColor(VkFormat format, VkClearColorValue value)
+{
+    if (isScaledFormat(format))
+    {
+        const auto channelClass = getTextureChannelClass(mapVkFormat(format).type);
+        for (unsigned c = 0; c < 4; ++c)
+            value.float32[c] = channelClass == TEXTURECHANNELCLASS_SIGNED_INTEGER ?
+                                  float(value.int32[c]) : float(value.uint32[c]);
+    }
+    return value;
+}
