+void VulkanReplayDumpResourcesBase::OverrideCmdDrawMultiEXT(const ApiCallInfo& call_info, PFN_vkCmdDrawMultiEXT func, VkCommandBuffer commandBuffer, uint32_t drawCount, const VkMultiDrawInfoEXT* pVertexInfo, uint32_t instanceCount, uint32_t firstInstance, uint32_t stride)
+{
+    for (auto context : FindDrawCallDumpingContexts(commandBuffer))
+    {
+        // Preserve the original multi-draw command and DrawID semantics. This
+        // incremental diagnostic implementation qualifies one-element arrays.
+        if (drawCount == 1)
+        {
+            context->CmdDraw(call_info, [&](VkCommandBuffer cb, auto... ignored) { func(cb, drawCount, pVertexInfo, instanceCount, firstInstance, stride); }, commandBuffer,
+                pVertexInfo->vertexCount, instanceCount, pVertexInfo->firstVertex, firstInstance, true);
+        }
+        else
+        {
+            if (context->MustDumpDrawCall(call_info.index))
+                GFXRECON_LOG_FATAL("Resource dumping multi-draw arrays requires drawCount=1 (call %llu)",
+                                  static_cast<unsigned long long>(call_info.index));
+            CommandBufferIterator first, last;
+            context->GetDrawCallActiveCommandBuffers(first, last);
+            for (auto it = first; it != last; ++it) func(*it, drawCount, pVertexInfo, instanceCount, firstInstance, stride);
+        }
+    }
+    for (auto context : FindDispatchTraceRaysContexts(commandBuffer))
+    {
+        auto cb = context->GetDispatchRaysCommandBuffer();
+        if (cb != VK_NULL_HANDLE) func(cb, drawCount, pVertexInfo, instanceCount, firstInstance, stride);
+    }
+}
