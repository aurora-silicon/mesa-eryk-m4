+        }
+        else
+        {
+            if (context->MustDumpDrawCall(call_info.index))
+                GFXRECON_LOG_FATAL("Resource dumping multi-draw arrays requires drawCount=1 (call %llu)",
+                                  static_cast<unsigned long long>(call_info.index));
+            CommandBufferIterator first, last;
+            context->GetDrawCallActiveCommandBuffers(first, last);
+            for (auto it = first; it != last; ++it) func(*it, drawCount, pIndexInfo, instanceCount, firstInstance, stride, pVertexOffset);
+        }
+    }
+    for (auto context : FindDispatchTraceRaysContexts(commandBuffer))
+    {
+        auto cb = context->GetDispatchRaysCommandBuffer();
+        if (cb != VK_NULL_HANDLE) func(cb, drawCount, pIndexInfo, instanceCount, firstInstance, stride, pVertexOffset);
+    }
+}
