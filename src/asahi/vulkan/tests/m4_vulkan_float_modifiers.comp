#version 450
// SPDX-License-Identifier: MIT
layout(local_size_x=32) in;
layout(set=0,binding=0,std430) buffer Data { uint v[]; } data;
void main() {
 uint i=gl_LocalInvocationID.x;
 float a=uintBitsToFloat(data.v[i]);
 float r=i < 16 ? clamp(abs(a)-1.0,0.0,1.0) :
                  clamp(abs(a)*0.5,0.0,1.0);
 data.v[i]=floatBitsToUint(r);
}
