#version 450
#extension GL_ARB_gpu_shader_int64 : require
layout(local_size_x=32) in;
layout(set=0, binding=0, std430) buffer Data { uint words[]; } data;
void main()
{
   uint i = gl_GlobalInvocationID.x * 6;
   uint x = data.words[i], y = data.words[i + 1];
   uint64_t u = uint64_t(x) * uint64_t(y);
   int64_t s = int64_t(int(x)) * int64_t(int(y));
   data.words[i + 2] = uint(u);
   data.words[i + 3] = uint(u >> 32);
   data.words[i + 4] = uint(s);
   data.words[i + 5] = uint(s >> 32);
}
