#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Output {
   uint values[];
} output_buffer;

/* Single-variable companion to g17p_vulkan_compute_cover.comp.
 *
 * cover writes ONE element from values[gl_GlobalInvocationID.x]. This is the
 * same store indexed by gl_LocalInvocationID instead, and the two ids reach
 * the shader by completely different routes:
 *
 *   gl_LocalInvocationID.x   a raw hardware special register
 *   gl_GlobalInvocationID.x  imad(workgroup_id, workgroup_size, local_id)
 *
 * So the pair separates two hypotheses that produce IDENTICAL output for
 * cover and min, yet are entirely different bugs:
 *
 *   32 elements written -> every invocation runs and stores. Coverage is
 *                          fine; the defect is in composing
 *                          gl_GlobalInvocationID -- if the local-id addend
 *                          is lost, every lane computes wgid*32 + 0 == 0 and
 *                          all 32 stores collide on index 0, which is exactly
 *                          what cover and min show.
 *   1 element written   -> the invocations genuinely do not run, and coverage
 *                          is real.
 *
 * The value carries the id too, so a written element reports which lane
 * produced it. (A bare literal here does not encode -- the id must be
 * consumed by arithmetic as well as by the address.)
 */
void
main()
{
   uint l = gl_LocalInvocationID.x;
   output_buffer.values[l] = 0x44440000u + l;
}
