#version 450
// SPDX-License-Identifier: MIT
layout(local_size_x=32) in;
layout(set=0,binding=0,std430) buffer Data { uint v[]; } data;
void main() {
 uint i=gl_LocalInvocationID.x;
 uint word=data.v[i];
 float a=uintBitsToFloat(word & 0xffff0000u);
 float b=unpackHalf2x16(word).x;
 float r=i < 16 ? (b < a ? 0.0 : a) : (b >= a ? 0.0 : a);
 data.v[i]=floatBitsToUint(r);
}
