#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

/* No descriptor set, no buffer, no memory access of any kind.
 *
 * A dispatch of this shader needs NO preamble loads: the Ioto program that
 * runs before the first shader instruction has nothing to fetch, so
 * hk_g17p_compute_uniform_ranges yields zero ranges and the composer emits
 * the no-resource program. That makes this the only dispatch we can build
 * whose execution touches no memory at all, before or during the shader.
 *
 * barrier() is a control barrier: it survives dead-code elimination (so the
 * shader is not skipped as empty) without loading or storing anything.
 */
void
main()
{
   barrier();
}
