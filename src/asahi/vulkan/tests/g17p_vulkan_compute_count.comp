#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Output {
   uint values[];
} output_buffer;

/* Answers one question the index-addressed probes cannot: did the other 31
 * invocations RUN?
 *
 * Every other probe stores to values[index], so an invocation whose computed
 * address is wrong looks exactly like one that never launched -- with soft
 * faults enabled the store is silently discarded and the element reads back
 * as its prefill.  Here every invocation stores to the SAME slot and puts its
 * own ID in the VALUE, so the address cannot vary and the winner of the race
 * reports which invocation it was.
 *
 *   values[0] == prefill sentinel -> nothing ran at all
 *   values[0] == 0x11110000       -> only ID 0 stored (one invocation, or the
 *                                    ID register is not being delivered)
 *   values[0] == 0x1111xxxx, xx!=0 -> several invocations ran AND their IDs
 *                                    are distinct and delivered, so the
 *                                    dispatch covers the grid and it is the
 *                                    index-addressed stores that are lost
 *
 * gl_WorkGroupID.x supplies the slot rather than a literal 0 for two reasons:
 * it is genuinely 0 at runtime for this one-group dispatch, and being a system
 * value it survives constant folding, so the store keeps the register-base
 * form.  That matters because the AGX3 packer currently encodes only ONE store
 * per shader and rejects a constant/uniform-base store combined with a
 * register-indexed one (VK_ERROR_FEATURE_NOT_PRESENT out of
 * agx_compile_shader_nir); this shape is the one that survives.
 */
void
main()
{
   uint g = gl_GlobalInvocationID.x;
   uint slot = gl_WorkGroupID.x;

   output_buffer.values[slot] = 0x11110000u + g;
}
