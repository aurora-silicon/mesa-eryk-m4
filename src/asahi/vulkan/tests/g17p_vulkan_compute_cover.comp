#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Output {
   uint values[];
} output_buffer;

/* Separates GRID COVERAGE from VALUE PRODUCTION.
 *
 * Every probe so far stores a computed value at a computed address, so a wrong
 * element and a missing invocation are indistinguishable.  Here the address is
 * still index-derived -- that is the thing under test -- but the value is a
 * bare literal with no arithmetic and no operand of any kind.
 *
 *   32 elements hold 0xcafe0000  -> every invocation ran and addressed
 *                                   correctly; whatever is wrong is entirely
 *                                   in how VALUES are produced
 *   8 elements                   -> coverage really is 8, and the value bugs
 *                                   are a separate defect on top
 *   1 element                    -> only invocation 0 exists
 *
 * One SSBO access, literal value: the only shape the AGX3 packer accepts (see
 * src/asahi/isa/README-agx3-packer-limits.md).
 */
void
main()
{
   output_buffer.values[gl_GlobalInvocationID.x] = 0xcafe0000u;
}
