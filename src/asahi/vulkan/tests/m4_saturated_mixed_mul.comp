#version 450
layout(local_size_x=32) in;
layout(set=0,binding=0,std430) buffer Data { uint d[]; };
void main() {
 uint i=gl_GlobalInvocationID.x*4;
 float x=uintBitsToFloat(d[i]);
 vec2 h=unpackHalf2x16(d[i+1]);
 d[i+2]=floatBitsToUint(clamp(x*h.x,0.0,1.0));
 d[i+3]=floatBitsToUint(clamp(x*h.y,0.0,1.0));
}
