#!/bin/sh
set -eu
[ "$(uname -r)" = 7.1.9-eryk-m4j613-j613-d3 ]
MESA=/opt/mesa-j613-25g83-d3
expected=edb7c015e0916be6e44d6a811b4161d5cbcb94c2aba1799ada05f5f2dbf65603
actual=$(sha256sum "$MESA/lib/dri/libgallium-26.1.4.so")
[ "${actual%% *}" = "$expected" ] || { echo "D3 Mesa hash mismatch" >&2; exit 1; }
card=$(readlink -f /dev/dri/by-path/platform-soc:display-subsystem-card)
[ -c "$card" ]
export AQ_DRM_DEVICES="$card"
export LD_LIBRARY_PATH="$MESA/lib:$MESA/lib/dri"
export GBM_BACKENDS_PATH="$MESA/lib/gbm" LIBGL_DRIVERS_PATH="$MESA/lib/dri"
export __EGL_VENDOR_LIBRARY_FILENAMES="$MESA/egl-vendor.json"
export VK_DRIVER_FILES="$MESA/asahi_icd.json" VK_ICD_FILENAMES="$MESA/asahi_icd.json"
export ASAHI_M3_EXPERIMENTAL=1
unset LD_PRELOAD LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER MESA_LOADER_DRIVER_OVERRIDE ASAHI_G15G_UNSCHEDULED ASAHI_MESA_DEBUG
exec "$@"
