#!/bin/sh
# Kernel-specific runtime integration. All persisted owner configuration is read-only.
set -eu
[ "$(uname -r)" = 7.1.9-eryk-m4j613-j613-d2 ] || exit 0
normal=$1; early=$2
runtime=/run/j613-d2
mkdir -p "$runtime/sddm.conf.d" "$early/sddm.service.d" /run/modules-load.d
if [ -d /etc/sddm.conf.d ]; then cp -a /etc/sddm.conf.d/. "$runtime/sddm.conf.d/"; fi
cat > "$runtime/sddm.conf.d/zz-j613-d2.conf" <<'CONF'
[General]
DisplayServer=wayland
[Wayland]
CompositorCommand=/usr/libexec/j613-d2-gpu-env /usr/bin/start-hyprland -- --config /usr/share/sddm/hyprland.lua
[Autologin]
User=
Session=
Relogin=false
CONF
# Bind the clone only into SDDM's mount namespace; #36 keeps its own configuration.
cat > "$early/sddm.service.d/j613-d2.conf" <<'CONF'
[Service]
BindReadOnlyPaths=/run/j613-d2/sddm.conf.d:/etc/sddm.conf.d
Environment=LD_LIBRARY_PATH=/opt/mesa-j613-25g83-d2/lib:/opt/mesa-j613-25g83-d2/lib/dri
Environment=LIBGL_DRIVERS_PATH=/opt/mesa-j613-25g83-d2/lib/dri
Environment=GBM_BACKENDS_PATH=/opt/mesa-j613-25g83-d2/lib/gbm
Environment=__EGL_VENDOR_LIBRARY_FILENAMES=/opt/mesa-j613-25g83-d2/egl-vendor.json
Environment=ASAHI_M3_EXPERIMENTAL=1
CONF
# Early generator output outranks /etc's old broad *m4j613* test-only unit.
ln -sf /dev/null "$early/m4j613-test-autoreboot.service"
cat > /run/modules-load.d/j613-d2.conf <<'CONF'
asahi
gpio-shared-proxy
hid_apple_mtp_haptic
hid_magicmouse
brcmfmac
CONF
