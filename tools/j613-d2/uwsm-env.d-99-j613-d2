# Proposed ~/.config/uwsm/env.d/99-j613-d2, applied only after owner plan acceptance.
# Sourced at UWSM environment preparation. Do not execute this as a standalone launcher.
if [ "$(uname -r)" = 7.1.9-eryk-m4j613-j613-d2 ]; then
    MESA=/opt/mesa-j613-25g83-d2
    export LD_LIBRARY_PATH="$MESA/lib:$MESA/lib/dri"
    export GBM_BACKENDS_PATH="$MESA/lib/gbm" LIBGL_DRIVERS_PATH="$MESA/lib/dri"
    export __EGL_VENDOR_LIBRARY_FILENAMES="$MESA/egl-vendor.json"
    export VK_DRIVER_FILES="$MESA/asahi_icd.json" VK_ICD_FILENAMES="$MESA/asahi_icd.json"
    export ASAHI_M3_EXPERIMENTAL=1
    export AQ_DRM_DEVICES=/dev/dri/by-path/platform-soc:display-subsystem-card
    unset LD_PRELOAD LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER MESA_LOADER_DRIVER_OVERRIDE
    unset ASAHI_G15G_UNSCHEDULED ASAHI_MESA_DEBUG MESA
fi
